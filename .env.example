# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Connection URL
DATABASE_URL="postgresql://postgres:Admin@127.0.0.1:5432/enterprise"

# JWT Secret: Recommended for production token signing.
JWT_SECRET="your-super-secret-key-change-for-production"

